# ==============================================================================
# Run for Victory - Git Ignore Configuration
# Enforces complete security for keystores, private keys, environment variables,
# build binaries, and vendor secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Variables & Secrets (CRITICAL SECURITY)
# ------------------------------------------------------------------------------
# Ignore all environment files except documented examples
.env
.env.*
*.env
!.env.example
!*.env.example

# Service account credentials & cloud provider keys
google-services.json
service-account*.json
*-service-account*.json
firebase-adminsdk*.json
secrets/
*.pem
*.p12
*.crt
*.cert

# ------------------------------------------------------------------------------
# 2. Keystores & Application Signing (CRITICAL SECURITY)
# ------------------------------------------------------------------------------
# Never commit release or debug signing keys
*.jks
*.keystore
keystore/
signing/
*.key

# ------------------------------------------------------------------------------
# 3. Android & Gradle Build Artifacts
# ------------------------------------------------------------------------------
# Built application binaries
*.apk
*.aab
*.aar
*.ap_

# Files for the ART/Dalvik VM
*.dex
*.class

# Build directories
build/
app/build/
bin/
gen/
out/
.gradle/

# Local SDK configuration
local.properties

# Proguard / R8 generated output
proguard/
app/proguard/

# Navigation & Translation caches
.navigation/
.extra/
captures/

# ------------------------------------------------------------------------------
# 4. Logs & Diagnostics
# ------------------------------------------------------------------------------
*.log

# ------------------------------------------------------------------------------
# 5. IDE, Editor & OS Artifacts
# ------------------------------------------------------------------------------
# Android Studio / IntelliJ IDEA
*.iml
.idea/
.idea/caches/
.idea/libraries/
.idea/modules.xml
.idea/workspace.xml

# Visual Studio Code
.vscode/

# Operating System files
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
