# ==============================================================================
# Run for Victory - Environment Configuration Template
# Package: com.runforvictory.tuition
# Subtitle: By Ravi Kumar
# DO NOT COMMIT REAL PRODUCTION SECRETS OR SERVICE ROLE KEYS TO SOURCE CONTROL
# ==============================================================================

# Client-side configuration (safe for Android BuildConfig, public anon credentials)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-public-anon-key-here
MAPS_API_KEY=your-google-maps-api-key-here

# Center Geofence Defaults (Asia/Kolkata)
DEFAULT_CENTER_LAT=17.385044
DEFAULT_CENTER_LNG=78.486671
DEFAULT_RADIUS_METERS=150
DEFAULT_TIMEZONE=Asia/Kolkata

# Server-side Only Secrets (NEVER place these in the Android app build)
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# FIREBASE_PROJECT_ID=run-for-victory
# FIREBASE_SERVICE_ACCOUNT_JSON=path/to/firebase-service-account.json
# DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
