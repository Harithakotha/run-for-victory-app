# ==============================================================================
# Production Environment Configuration Template
# Project: Run for Victory (By Ravi Kumar)
# DO NOT COMMIT ACTUAL PRODUCTION VALUES TO SOURCE CONTROL
# ==============================================================================

# Supabase Production Project
SUPABASE_URL=https://rfv-prod-project.supabase.co
SUPABASE_ANON_KEY=<PROD_SUPABASE_ANON_PUBLIC_KEY>
SUPABASE_SERVICE_ROLE_KEY=<PROD_VAULTED_SERVICE_ROLE_KEY>

# Production Database Direct & Pooler Connection Strings
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres

# Firebase Cloud Messaging Production Project
FIREBASE_PROJECT_ID=run-for-victory-prod
FIREBASE_SERVICE_ACCOUNT_KEY=<VAULTED_FIREBASE_ADMIN_SERVICE_ACCOUNT_JSON>

# Production Geofence Coordinates (Run for Victory - Hyderabad Centre)
CENTRE_LATITUDE=17.385044
CENTRE_LONGITUDE=78.486671
CENTRE_RADIUS_METERS=150
CENTRE_MAX_ACCURACY_METERS=60.0
CENTRE_TIMEZONE=Asia/Kolkata

# Mobile App Release Integrity (SHA-256 Fingerprint for SMS/Auth verification)
APP_SIGNING_SHA256=<PROD_RELEASE_KEYSTORE_SHA256_FINGERPRINT>
