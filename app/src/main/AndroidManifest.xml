<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permissions required for networking, GPS verification, and push notifications -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".app.RunForVictoryApp"
        android:allowBackup="true"
        android:icon="@drawable/ic_run_for_victory_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_run_for_victory_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.RunForVictory">
        
        <activity
            android:name=".app.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.RunForVictory">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
